# SocialControl AI — saari keys yahan (ya app ke Settings screen me). Ye file kabhi GitHub pe commit NA karo.
# Copy karo:  .env.example  ->  .env


# ===== Trends =====
# YouTube Data API v3 key — Trending videos + channel scan
# Kahan se: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Instagram Graph API token (Business/Creator) — IG hashtag trends + Reels post
# Kahan se: https://developers.facebook.com/tools/explorer/
IG_ACCESS_TOKEN=
# Instagram Business account ID — IG hashtag trends + Reels post
# Kahan se: https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/getting-started
IG_USER_ID=

# ===== AI =====
# Gemini API key (Google AI Studio) — Script, title, description, hashtags, AI images, Veo, quality rating
# Kahan se: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ===== Media =====
# Pexels API key — Free stock videos/photos
# Kahan se: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay API key — Free stock videos/photos
# Kahan se: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ===== Voice =====
# ElevenLabs API key (optional) — Premium voice (Edge TTS is free default)
# Kahan se: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ElevenLabs voice ID (optional) — Premium voice
# Kahan se: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# ===== AI Video =====
# fal.ai key (optional) — AI video (Kling/Luma/Minimax via fal)
# Kahan se: https://fal.ai/dashboard/keys
FAL_KEY=
# Kling access key (optional) — AI video
# Kahan se: https://app.klingai.com/global/dev/api-key
KLING_ACCESS_KEY=
# Kling secret key (optional) — AI video
# Kahan se: https://app.klingai.com/global/dev/api-key
KLING_SECRET_KEY=
# Runway API key (optional) — AI video
# Kahan se: https://dev.runwayml.com/
RUNWAY_API_KEY=
# Luma Dream Machine key (optional) — AI video
# Kahan se: https://lumalabs.ai/dream-machine/api/keys
LUMA_API_KEY=

# ===== Post =====
# YouTube OAuth client_secret.json path — Auto upload + Full Control (API mode)
# Kahan se: https://console.cloud.google.com/apis/credentials
YT_CLIENT_SECRET_FILE=
# Pinterest token (optional, apni video post) — Post your own video as a Pin
# Kahan se: https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=
# Pinterest board ID (optional) — Post your own video as a Pin
# Kahan se: https://developers.pinterest.com/docs/api/v5/boards-list/
PINTEREST_BOARD_ID=

# ===== Optional tuning =====
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# VEO_MODEL=veo-3.0-fast-generate-001
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# SC_PORT=8765
# SC_AUTO_APPROVE=1   # sirf GitHub Actions / headless ke liye (bina puche post)
