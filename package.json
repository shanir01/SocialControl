{
  "name": "socialcontrol",
  "productName": "SocialControl AI",
  "version": "1.0.0",
  "description": "SocialControl AI — Social Automation (desktop app + local server + phone dashboard)",
  "author": "Nirbhay Sharma (NISHU)",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "check": "node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/agent.js && node --check web/app.js && node --check web/fcsim.js && node --check web/demo.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.socialcontrol.app",
    "productName": "SocialControl AI",
    "icon": "desktop/icon.png",
    "files": ["desktop/**", "web/**", "package.json"],
    "extraResources": [
      { "from": "backend", "to": "backend", "filter": ["**/*", "!**/__pycache__/**", "!tests/**"] },
      { "from": "requirements.txt", "to": "requirements.txt" }
    ],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Utility" }
  }
}
